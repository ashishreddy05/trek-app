# Trek — environment variables
# Names and purposes only. NEVER commit real values. On Vercel, set these under
# Project → Settings → Environment Variables. src/config.js validates them at boot.

# ---- Environment ----
APP_ENV=dev                          # dev | staging | prod
APP_BASE_URL=http://localhost:3000   # the address people open; https outside dev. Used in emailed links
PORT=3000                            # local only; ignored on Vercel

# ---- Database (PostgreSQL) ----
# Copy URLs from Neon → Connect after creating your project.
# Local setup: owner pooled URL here, owner direct URL in DATABASE_URL_UNPOOLED.
# Vercel: only the pooled trek_app URL; never the owner/direct credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL_MODE=require            # 'disable' only for a local database
DATABASE_POOL_MAX=                   # defaults to 3 on Vercel, 10 elsewhere

# ---- Sessions (ST-06 PROVISIONAL: opaque, server-side) ----
SESSION_COOKIE_NAME=trek_session
SESSION_TTL_HOURS=12

# ---- Email (Slot 5 PROVISIONAL: Resend recommended) ----
# Used only for password reset and sign-in invite links.
#   resend | postmark   real delivery
#   disabled            sign-in still works; operators issue links with scripts/issue-password-link.js
#   console             dev only — prints to the server terminal. Refused outside dev.
MAIL_DRIVER=console
MAIL_API_KEY=                        # SECRET
MAIL_FROM_ADDRESS=                   # e.g. trek@mail.garageplug.com, on a verified domain
MAIL_FROM_NAME=Trek
MAIL_STREAM=                         # postmark only

# ---- Logging ----
LOG_LEVEL=info
ERROR_LOGGING_DSN=                   # SECRET, optional (Sentry)

# ---- Who may sign in ----
LOGIN_EMAIL_DOMAINS=garageplug.com

# ---- Staging reset opt-in ----
# 'yes' on STAGING ONLY, and only on the computer running the reset.
# NEVER set this in the production project.
TREK_ALLOW_STAGING_RESET=
